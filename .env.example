# ============================================================
# docker-compose 环境变量样例
# 使用：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不入库）
# ============================================================

# MySQL root 密码（必填）
MYSQL_ROOT_PASSWORD=change-me

# 数据库名（默认 cache_db_v3，Flyway 启动时自动建表+种子数据）
MYSQL_DATABASE=cache_db_v3

# Redis 密码（compose 内 Redis 默认无密码，留空即可；如启用 requirepass 需同步修改 redis 服务 command）
REDIS_PASSWORD=

# Redis database 编号（compose 内默认 0；本地连 Windows Redis 时常用 1 避免与 v2 冲突）
REDIS_DATABASE=0

# CORS 白名单（逗号分隔；* 表示全放行，仅建议演示环境使用）
CORS_ALLOWED_ORIGINS=*

# 待支付订单超时自动取消（分钟）
ORDER_TIMEOUT_MINUTES=30
