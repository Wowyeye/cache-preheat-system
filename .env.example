# ============================================================
# docker-compose 环境变量样例
# 使用：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不入库）
# ============================================================

# MySQL root 密码（必填）
MYSQL_ROOT_PASSWORD=change-me

# 数据库名（默认 cache_db_v3，Flyway 启动时自动建表+种子数据）
MYSQL_DATABASE=cache_db_v3

# Redis 密码（compose 内 Redis 默认无密码，留空即可；如启用 requirepass 需同步修改 redis 服务 command）
REDIS_PASSWORD=

# Redis database 编号（compose 内默认 0；本地连 Windows Redis 时常用 1 避免与 v2 冲突）
REDIS_DATABASE=0

# CORS 白名单（逗号分隔；* 表示全放行，仅建议演示环境使用）
CORS_ALLOWED_ORIGINS=*

# 待支付订单超时自动取消（分钟）
ORDER_TIMEOUT_MINUTES=30

# 可信代理列表（逗号分隔，支持 IPv4 与 CIDR）。
# 留空 = 完全不信任 X-Forwarded-For（客户端 IP 取 socket 地址，最安全，防伪造头绕过 IP 限流）。
# 只有当应用部署在 Nginx/网关后面时才需要填，例如：10.0.0.0/8,192.168.1.10
APP_TRUSTED_PROXIES=

# ============================================================
# 镜像构建换源（可选；国内网络强烈建议打开）
#   官方 repo.maven.apache.org 常被墙，会卡在 "wget: Failed to fetch ...apache-maven-3.9.6-bin"
#   留空 / 不写 = 走官方源（默认，适合海外或已配代理的环境）
# ============================================================
# Maven Wrapper 分发包仓库前缀（wrapper 会拼上 /org/apache/maven/...）
MVNW_REPOURL=https://maven.aliyun.com/repository/public
# Maven 依赖仓库镜像（写入容器内 ~/.m2/settings.xml 的 mirror）
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
