<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jyu.cache.mapper.UserMapper">

    <resultMap id="userMap" type="com.jyu.cache.entity.SysUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByUsername" resultMap="userMap">
        SELECT id, username, password, nickname, role, status, create_time
        FROM sys_user
        WHERE username = #{username}
    </select>

    <select id="selectById" resultMap="userMap">
        SELECT id, username, password, nickname, role, status, create_time
        FROM sys_user
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, nickname, role)
        VALUES (#{username}, #{password}, #{nickname}, #{role})
    </insert>

</mapper>
