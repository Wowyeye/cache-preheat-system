<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 商品分类 Mapper XML，对应 com.jyu.cache.mapper.CategoryMapper 接口 -->
<mapper namespace="com.jyu.cache.mapper.CategoryMapper">

    <resultMap id="categoryMap" type="com.jyu.cache.entity.Category">
        <id     property="id"   column="id"/>
        <result property="name" column="name"/>
        <result property="sort" column="sort"/>
    </resultMap>

    <!-- 查询所有分类（按排序号升序） -->
    <select id="selectAll" resultMap="categoryMap">
        SELECT id, name, sort FROM category ORDER BY sort ASC
    </select>

    <!-- 根据ID查询分类 -->
    <select id="selectById" resultMap="categoryMap">
        SELECT id, name, sort FROM category WHERE id = #{id}
    </select>
</mapper>
